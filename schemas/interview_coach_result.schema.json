{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interview Coach Result",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "role",
    "role_label",
    "question_id",
    "question",
    "first_answer",
    "recommendation"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "product": { "const": "interview-coach-agent" },
    "role": { "type": "string" },
    "role_label": { "type": "string" },
    "question_id": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "first_answer": { "$ref": "#/$defs/attempt" },
    "second_answer": { "$ref": "#/$defs/attempt" },
    "comparison": {
      "type": "object",
      "required": [
        "total_delta",
        "dimension_delta",
        "improved_dimensions",
        "regressed_dimensions",
        "verdict"
      ],
      "properties": {
        "total_delta": { "type": "number" },
        "dimension_delta": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "improved_dimensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "regressed_dimensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verdict": { "enum": ["improved", "not_improved"] }
      },
      "additionalProperties": false
    },
    "recommendation": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "attempt": {
      "type": "object",
      "required": [
        "answer",
        "question_id",
        "scores",
        "total_score",
        "features",
        "issues",
        "followups",
        "rewrite"
      ],
      "properties": {
        "answer": { "type": "string", "minLength": 1 },
        "question_id": { "type": "string" },
        "scores": {
          "type": "object",
          "required": [
            "structure",
            "specificity",
            "metrics",
            "role_fit",
            "clarity",
            "risk_control"
          ],
          "properties": {
            "structure": { "type": "integer", "minimum": 1, "maximum": 7 },
            "specificity": { "type": "integer", "minimum": 1, "maximum": 7 },
            "metrics": { "type": "integer", "minimum": 1, "maximum": 7 },
            "role_fit": { "type": "integer", "minimum": 1, "maximum": 7 },
            "clarity": { "type": "integer", "minimum": 1, "maximum": 7 },
            "risk_control": { "type": "integer", "minimum": 1, "maximum": 7 }
          },
          "additionalProperties": false
        },
        "total_score": { "type": "number", "minimum": 1, "maximum": 7 },
        "features": { "type": "object" },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "detail"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "detail": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "followups": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rewrite": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
